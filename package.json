{
  "name": "charmap2",
  "private": true,
  "version": "0.2.0",
  "description": "A static Unicode character map for searching, inspecting, and copying Unicode characters.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "homepage": "https://llaurila.github.io/charmap2/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llaurila/charmap2.git"
  },
  "bugs": {
    "url": "https://github.com/llaurila/charmap2/issues"
  },
  "keywords": [
    "unicode",
    "character-map",
    "react",
    "vite",
    "search",
    "static-site"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run generate:icons && pnpm run generate:unicode && vite",
    "build": "pnpm run generate:icons && pnpm run generate:unicode && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "vendor:unicode": "tsx scripts/unicode/vendor.ts",
    "generate:unicode": "tsx scripts/unicode/generate.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
